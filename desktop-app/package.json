{
  "name": "zalo-marketing-desktop",
  "version": "1.0.0",
  "description": "Zalo Marketing Desktop Application",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:worker\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:worker": "ts-node-dev --respawn --transpile-only worker/api-server.ts",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:electron": "wait-on http://localhost:3001 http://localhost:3002 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:worker && npm run build:renderer && npm run build:electron",
    "build:worker": "tsc --project tsconfig.worker.json",
    "build:renderer": "cd renderer && npm run build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build:win": "npm run build && electron-builder --win --x64",
    "pack": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "zalo",
    "marketing",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "playwright": "^1.40.0",
    "zca-js": "^2.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^24.9.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.zalomarketing.desktop",
    "productName": "Zalo Marketing",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
