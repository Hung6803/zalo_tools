import React, { useState, useEffect } from 'react';
import {
  Box,
  Typography,
  Button,
  Paper,
  Alert,
  CircularProgress,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Select,
  MenuItem,
  FormControl,
  InputLabel,
  Chip,
  Card,
  CardContent,
  CardActions,
  Grid,
  IconButton,
  Tooltip,
  LinearProgress,
  Stack,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  Avatar,
  Checkbox,
} from '@mui/material';
import {
  Add,
  PlayArrow,
  Pause,
  Stop,
  Delete,
  Visibility,
  ExpandMore,
  FileUpload,
  FileDownload,
  ArrowBack,
  Refresh,
} from '@mui/icons-material';
import {
  sendMessage,
  sendFriendRequest,
  findUser,
  getFriendSuggestions,
  cancelFriendRequest,
  addMembersToGroup,
  joinGroup,
  getContactsWithBirthday,
  getContactGroups,
  getZaloAccounts,
  getPreviousRecipients,
  ZaloAccount,
} from '../api/localApi';
import {
  CampaignType,
  getCampaignTypesByCategory,
  requiresTemplate,
  requiresGroup,
  requiresGroupMembers,
  supportsPhoneInput,
  supportsOptionalTemplate,
  CATEGORY_LABELS,
} from '../constants/campaignTypes';
import {
  importRecipientsFromExcel,
  downloadBulkSendTemplate,
} from '../utils/excelUtils';
import {
  utcToVietnamTime,
  getVietnamTimeAfterMinutes,
  vietnamInputToUTC,
} from '../utils/dateUtils';
import AccountSelector from './AccountSelector';

interface Template {
  id: number;
  name: string;
  content: string;
  imageUrl?: string;
  variables: string[];
}

interface Recipient {
  userId: string; // Can be actual userId or phone number (for backward compatibility)
  zaloId?: string; // Optional Zalo User ID - prioritized for sending
  phoneNumber?: string; // Optional phone number - used if zaloId not available
  displayName: string;
  variables: Record<string, string>;
  source?: 'phone' | 'excel' | 'group' | 'contact_group'; // Track where recipient came from
}

interface Campaign {
  id: number;
  accountId: number;
  batchId?: string;
  name: string;
  description?: string;
  campaignType: CampaignType;
  templateId?: number;
  recipients: Recipient[];
  groupId?: string;
  targetSource?: string;
  automationRules?: string;
  contactGroupId?: number;
  scheduledAt?: string;
  rateLimit?: number;
  delayMs: number;
  maxRetries: number;
  status: 'draft' | 'scheduled' | 'pending' | 'running' | 'paused' | 'completed' | 'stopped' | 'failed';
  totalRecipients: number;
  sentCount: number;
  failedCount: number;
  startedAt?: string;
  completedAt?: string;
  createdAt: string;
  updatedAt: string;
}

interface CampaignsPanelProps {
  accountId?: number; // Made optional - now managed internally
}

const CampaignsPanel: React.FC<CampaignsPanelProps> = ({ accountId: propAccountId }) => {
  const [campaigns, setCampaigns] = useState<Campaign[]>([]);
  const [templates, setTemplates] = useState<Template[]>([]);
  const [accounts, setAccounts] = useState<ZaloAccount[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');
  const [dialogError, setDialogError] = useState('');

  // Field-level errors for inline validation
  const [fieldErrors, setFieldErrors] = useState({
    name: '',
    accountIds: '',
    templateId: '',
    groupId: '',
    recipients: '',
    scheduledAt: '',
    groupLink: '',
  });

  const [viewMode, setViewMode] = useState<'list' | 'create'>('list');
  const [deleteConfirmId, setDeleteConfirmId] = useState<number | null>(null);
  const [viewDetailsId, setViewDetailsId] = useState<number | null>(null);
  const [groups, setGroups] = useState<any[]>([]);

  // NEW: Internal account selection
  const [selectedAccountIds, setSelectedAccountIds] = useState<number[]>([]);
  const [formAccountIds, setFormAccountIds] = useState<number[]>([]);

  const [formName, setFormName] = useState('');
  const [formDescription, setFormDescription] = useState('');
  const [formCampaignType, setFormCampaignType] = useState<CampaignType>('message_to_phone');
  const [formTemplateId, setFormTemplateId] = useState<number | null>(null);
  const [formGroupId, setFormGroupId] = useState<string>('');
  const [formContactGroupId, setFormContactGroupId] = useState<number | null>(null);
  const [formScheduledAt, setFormScheduledAt] = useState<string>('');
  const [formRateLimit] = useState<number>(100);
  const [formRecipients, setFormRecipients] = useState<Recipient[]>([]);
  const [formDelayMs, setFormDelayMs] = useState(2000);
  const [formMaxRetries, setFormMaxRetries] = useState(2);
  const [contactGroups, setContactGroups] = useState<any[]>([]);

  // Group members management
  const [groupMembers, setGroupMembers] = useState<any[]>([]);
  const [groupLoadMethod, setGroupLoadMethod] = useState<'existing' | 'link'>('existing');
  const [groupLink, setGroupLink] = useState('');
  const [loadingGroupMembers, setLoadingGroupMembers] = useState(false);

  // Advanced rate limiting settings
  const [formDelayBetweenMessages, setFormDelayBetweenMessages] = useState(40); // seconds

  // Phone numbers input (for message_to_phone without Excel)
  const [phoneInput, setPhoneInput] = useState('');
  const [formMaxMessagesPerHour, setFormMaxMessagesPerHour] = useState(15);
  const [formTimeWindowMinutes, setFormTimeWindowMinutes] = useState(60);
  const [formRestMinutes, setFormRestMinutes] = useState(20);

  // Re-marketing date filter
  const [remarketingDateFrom, setRemarketingDateFrom] = useState<string>('');
  const [remarketingDateTo, setRemarketingDateTo] = useState<string>('');
  const [previousRecipients, setPreviousRecipients] = useState<any[]>([]);
  const [loadingPreviousRecipients, setLoadingPreviousRecipients] = useState(false);

  const [runningCampaignId, setRunningCampaignId] = useState<number | null>(null);

  // Get active recipients based on campaign type
  // Phone-input recipients only show for phone-based campaigns
  const getActiveRecipients = (): Recipient[] => {
    if (supportsPhoneInput(formCampaignType)) {
      // For phone-based campaigns: show all recipients
      return formRecipients;
    } else {
      // For non-phone campaigns: exclude phone-only recipients
      return formRecipients.filter(r => r.source !== 'phone');
    }
  };

  const activeRecipients = getActiveRecipients();

  // Initialize with prop accountId if provided (backward compatibility)
  useEffect(() => {
    if (propAccountId && selectedAccountIds.length === 0) {
      setSelectedAccountIds([propAccountId]);
    }
  }, [propAccountId]);

  // Load accounts on mount
  useEffect(() => {
    loadAccounts();
  }, []);

  useEffect(() => {
    loadCampaigns();
    loadTemplates();
  }, [selectedAccountIds]);

  // Auto-hide success message after 5 seconds
  useEffect(() => {
    if (success) {
      const timer = setTimeout(() => {
        setSuccess('');
      }, 5000);
      return () => clearTimeout(timer);
    }
  }, [success]);

  const loadContactGroups = async (accountId: number) => {
    try {
      const data = await getContactGroups(accountId);
      setContactGroups(data);
    } catch (err: any) {
      console.error('Failed to load contact groups:', err);
    }
  };

  const handleLoadGroupMembers = async () => {
    // Clear field errors
    setFieldErrors({
      ...fieldErrors,
      groupId: '',
      groupLink: '',
      accountIds: '',
    });

    if (!formGroupId && !groupLink) {
      setFieldErrors({
        ...fieldErrors,
        groupId: 'Vui lòng chọn nhóm hoặc nhập link mời nhóm',
        groupLink: 'Vui lòng chọn nhóm hoặc nhập link mời nhóm',
      });
      return;
    }

    if (formAccountIds.length === 0) {
      setFieldErrors({
        ...fieldErrors,
        accountIds: 'Vui lòng chọn tài khoản trước khi tải danh sách thành viên',
      });
      return;
    }

    // Validate group link format if using link method
    if (groupLoadMethod === 'link' && groupLink) {
      if (!groupLink.includes('zalo.me') && !groupLink.includes('chat.zalo.me')) {
        setFieldErrors({
          ...fieldErrors,
          groupLink: 'Link không hợp lệ. Vui lòng nhập link mời nhóm Zalo',
        });
        return;
      }
    }

    setLoadingGroupMembers(true);

    try {
      const accountId = formAccountIds[0];

      if (groupLoadMethod === 'link' && groupLink) {
        // Scrape group from link
        const response = await fetch('http://localhost:3001/local/scrape-group', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accountId, groupLink }),
        });

        const result = await response.json();
        if (!result.success) {
          setDialogError(`❌ ${result.error || 'Không thể load thành viên nhóm từ link'}`);
          return;
        }

        const { groupId, members } = result.data;
        setFormGroupId(groupId);
        setGroupMembers(members || []);
        setSuccess(`✅ Đã load ${members.length} thành viên từ link nhóm`);
      } else if (formGroupId) {
        // Load members from existing joined group
        const response = await fetch('http://localhost:3001/local/load-group-members', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            accountId,
            groupId: formGroupId,
          }),
        });

        const result = await response.json();
        if (!result.success) {
          setDialogError(`❌ ${result.error || 'Không thể load thành viên nhóm'}`);
          return;
        }

        const members = result.data || [];
        setGroupMembers(members);
        setSuccess(`✅ Đã load ${members.length} thành viên`);
      }
    } catch (err: any) {
      console.error('Error loading group members:', err);
      setDialogError('❌ Không thể load thành viên nhóm. Vui lòng kiểm tra kết nối và thử lại.');
    } finally {
      setLoadingGroupMembers(false);
    }
  };

  const handleSelectGroupMember = (member: any) => {
    const exists = formRecipients.some((r) => r.userId === member.userId);
    if (exists) {
      setFormRecipients(formRecipients.filter((r) => r.userId !== member.userId));
    } else {
      setFormRecipients([
        ...formRecipients,
        {
          userId: member.userId,
          displayName: member.displayName,
          variables: {},
          source: 'group',
        },
      ]);
    }
  };

  const loadCampaigns = async () => {
    if (selectedAccountIds.length === 0) {
      setCampaigns([]);
      return;
    }

    setLoading(true);
    try {
      // Load campaigns from all selected accounts
      const allCampaigns: Campaign[] = [];

      for (const accountId of selectedAccountIds) {
        const response = await fetch(`http://localhost:3001/local/campaigns/${accountId}`);
        const result = await response.json();

        if (result.success && result.data) {
          allCampaigns.push(...result.data);
        }
      }

      // Sort by creation date (newest first)
      allCampaigns.sort((a, b) =>
        new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
      );

      setCampaigns(allCampaigns);
    } catch (err: any) {
      console.error('Error loading campaigns:', err);
      setError('❌ Lỗi kết nối. Vui lòng kiểm tra kết nối mạng và thử lại.');
    } finally {
      setLoading(false);
    }
  };

  const loadTemplates = async () => {
    try {
      const response = await fetch(
        `http://localhost:3001/local/templates?activeOnly=true`,
      );
      const result = await response.json();

      if (result.success) {
        setTemplates(result.data);
      }
    } catch (err) {
      console.error('Failed to load templates:', err);
    }
  };

  const loadAccounts = async () => {
    try {
      const data = await getZaloAccounts();
      const activeAccounts = data.filter((acc) => acc.status === 'active');
      setAccounts(activeAccounts);
    } catch (err) {
      console.error('Failed to load accounts:', err);
    }
  };

  const loadGroups = async (accountId: number) => {
    try {
      const response = await fetch(`http://localhost:3001/local/groups/${accountId}`);
      const result = await response.json();

      if (result.success) {
        setGroups(result.data);
      }
    } catch (err) {
      console.error('Failed to load groups:', err);
    }
  };

  const loadPreviousRecipientsForRemarketing = async () => {
    if (formAccountIds.length === 0) {
      setDialogError('Vui lòng chọn tài khoản trước');
      return;
    }

    setLoadingPreviousRecipients(true);
    setDialogError('');

    try {
      // For now, use the first selected account
      const accountId = formAccountIds[0];
      const result = await getPreviousRecipients(accountId, remarketingDateFrom, remarketingDateTo);

      if (result.success && result.data) {
        setPreviousRecipients(result.data);

        // Convert to recipients format
        const recipients: Recipient[] = result.data.map((prev) => ({
          userId: prev.userId,
          displayName: prev.displayName,
          phoneNumber: prev.phoneNumber,
          variables: {},
          source: 'excel' as const, // Mark as excel to show in recipient list
        }));

        setFormRecipients(recipients);
        setSuccess(`Đã tải ${recipients.length} người nhận từ các chiến dịch trước`);
      } else {
        setDialogError(result.error || 'Không thể tải danh sách người nhận');
      }
    } catch (err: any) {
      console.error('Failed to load previous recipients:', err);
      setDialogError(`Lỗi tải danh sách: ${err.message}`);
    } finally {
      setLoadingPreviousRecipients(false);
    }
  };

  const handleOpenCreateView = () => {
    setFormName('');
    setFormDescription('');
    setFormCampaignType('message_to_phone');
    setFormTemplateId(null);
    setFormGroupId('');
    setFormRecipients([]);
    setPhoneInput(''); // Clear phone input
    setFormDelayMs(2000);
    setFormMaxRetries(2);
    setDialogError('');
    setError('');
    setGroupMembers([]);
    setGroupLink('');
    setFieldErrors({
      name: '',
      accountIds: '',
      templateId: '',
      groupId: '',
      recipients: '',
      scheduledAt: '',
      groupLink: '',
    });

    // Initialize with selected accounts, or empty array
    setFormAccountIds(selectedAccountIds.length > 0 ? selectedAccountIds : []);

    // Set default scheduled time to 5 minutes from now in Vietnam time
    const defaultScheduledTime = getVietnamTimeAfterMinutes(5);
    setFormScheduledAt(defaultScheduledTime);

    // Load groups and contact groups for first selected account
    const firstAccountId = selectedAccountIds[0];
    if (firstAccountId) {
      loadGroups(firstAccountId);
      loadContactGroups(firstAccountId);
    }
    setViewMode('create');
  };

  const handleImportRecipients = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) {
      console.log('❌ No file selected');
      return;
    }

    console.log('📁 File selected:', file.name);

    try {
      setLoading(true);
      setDialogError('');

      const selectedTemplateCurrent = templates.find((t) => t.id === formTemplateId);
      const templateVariables = selectedTemplateCurrent?.variables || [];
      console.log('📋 Template variables:', templateVariables);

      const excelRecipients = await importRecipientsFromExcel(file, templateVariables);
      console.log('📊 Excel recipients parsed:', excelRecipients.length, 'rows');

      const parsedRecipients: Recipient[] = excelRecipients.map((row) => {
        const variables: Record<string, string> = {};

        // Extract template variables from Excel row
        templateVariables.forEach((varName) => {
          if (row[varName]) {
            variables[varName] = row[varName];
          }
        });

        return {
          userId: row.userId,
          zaloId: row.zaloId, // Optional - from [ZALOID] column
          phoneNumber: row.phoneNumber, // Optional - from [MOBILE] column
          displayName: row.displayName,
          variables,
          source: 'excel', // Mark as Excel import source
        };
      });

      console.log('✅ Parsed recipients:', parsedRecipients);
      setFormRecipients(parsedRecipients);
      setSuccess(`Đã tải ${parsedRecipients.length} người nhận từ Excel`);
    } catch (err: any) {
      console.error('❌ Import error:', err);
      setDialogError(err.message || 'Không thể đọc file Excel. Vui lòng kiểm tra lại file.');
    } finally {
      setLoading(false);
      event.target.value = '';
    }
  };

  const handleAddPhoneNumbers = () => {
    if (!phoneInput.trim()) {
      setDialogError('Vui lòng nhập số điện thoại');
      return;
    }

    setDialogError('');

    // Parse phone numbers from input (split by comma only)
    const phoneNumbers = phoneInput
      .split(',')
      .map(phone => phone.trim())
      .filter(phone => phone.length > 0);

    if (phoneNumbers.length === 0) {
      setDialogError('Không tìm thấy số điện thoại hợp lệ');
      return;
    }

    // Convert phone numbers to recipients
    const newRecipients: Recipient[] = phoneNumbers.map((phone) => ({
      userId: phone, // Will be used to find user via findUser API
      phoneNumber: phone,
      displayName: phone, // Temporary display name
      variables: {},
      source: 'phone', // Mark as phone input source
    }));

    // Add to existing recipients (avoid duplicates)
    const existingPhones = new Set(formRecipients.map(r => r.phoneNumber || r.userId));
    const uniqueNewRecipients = newRecipients.filter(r => !existingPhones.has(r.phoneNumber || r.userId));

    if (uniqueNewRecipients.length === 0) {
      setDialogError('Tất cả số điện thoại đã tồn tại trong danh sách');
      return;
    }

    setFormRecipients([...formRecipients, ...uniqueNewRecipients]);
    setSuccess(`✅ Đã thêm ${uniqueNewRecipients.length} số điện thoại (${phoneNumbers.length - uniqueNewRecipients.length} trùng lặp)`);
    setPhoneInput(''); // Clear input
  };

  const handleCreateCampaign = async () => {
    // Clear all previous errors
    setDialogError('');
    setFieldErrors({
      name: '',
      accountIds: '',
      templateId: '',
      groupId: '',
      recipients: '',
      scheduledAt: '',
      groupLink: '',
    });

    let hasError = false;
    const newErrors = { ...fieldErrors };

    // Validation
    if (!formName.trim()) {
      newErrors.name = 'Vui lòng nhập tên chiến dịch';
      hasError = true;
    }

    if (formAccountIds.length === 0) {
      newErrors.accountIds = 'Vui lòng chọn ít nhất một tài khoản để tạo chiến dịch';
      hasError = true;
    }

    if (requiresTemplate(formCampaignType) && !formTemplateId) {
      newErrors.templateId = 'Loại chiến dịch này yêu cầu chọn template tin nhắn';
      hasError = true;
    }

    if (requiresGroup(formCampaignType) && !formGroupId) {
      newErrors.groupId = 'Vui lòng chọn nhóm hoặc tải danh sách thành viên từ link mời nhóm';
      hasError = true;
    }

    // For campaigns that need group members, check if members are loaded
    if (requiresGroupMembers(formCampaignType)) {
      if (activeRecipients.length === 0) {
        newErrors.recipients = 'Vui lòng tải danh sách thành viên nhóm bằng cách bấm nút "Tải danh sách thành viên"';
        hasError = true;
      } else {
        console.log(`✅ Loaded ${activeRecipients.length} group members for campaign`);
      }
    }

    // For "add_to_group" campaign, need recipients to add to the group
    if (formCampaignType === 'add_to_group') {
      if (activeRecipients.length === 0 && !formContactGroupId) {
        newErrors.recipients = 'Vui lòng thêm danh sách người dùng sẽ được thêm vào nhóm';
        hasError = true;
      }
    }

    // For non-group-based campaigns (except message_to_group which only sends to group chat), check recipients
    if (!requiresGroup(formCampaignType) && activeRecipients.length === 0 && !formContactGroupId) {
      newErrors.recipients = 'Vui lòng thêm người nhận hoặc chọn nhóm danh bạ';
      hasError = true;
    }

    // Validate scheduled time if provided
    if (formScheduledAt) {
      const scheduledTime = new Date(formScheduledAt);
      const now = new Date();
      if (scheduledTime <= now) {
        newErrors.scheduledAt = 'Thời gian hẹn giờ phải là thời điểm trong tương lai';
        hasError = true;
      }
    }

    // If there are errors, update state and return
    if (hasError) {
      setFieldErrors(newErrors);
      return;
    }

    setLoading(true);

    try {
      // Convert scheduledAt from Vietnam time (UTC+7) to UTC for database
      const scheduledAtUTC = formScheduledAt ? vietnamInputToUTC(formScheduledAt) : undefined;

      const batchId = formAccountIds.length > 1 ? `batch_${Date.now()}` : undefined;

      let successCount = 0;
      const errors: string[] = [];

      for (let i = 0; i < formAccountIds.length; i++) {
        const accountId = formAccountIds[i];

        let accountRecipients: Recipient[] = [];

        // If using contact group, don't divide recipients (backend will load from group)
        if (formContactGroupId) {
          accountRecipients = [];
        } else {
          // Divide recipients evenly across accounts (use activeRecipients for current campaign type)
          const recipientsPerAccount = Math.ceil(activeRecipients.length / formAccountIds.length);
          const startIdx = i * recipientsPerAccount;
          const endIdx = Math.min(startIdx + recipientsPerAccount, activeRecipients.length);
          accountRecipients = activeRecipients.slice(startIdx, endIdx);
        }

        // Skip if no recipients and no contact group
        if (accountRecipients.length === 0 && !formContactGroupId) continue;

        const campaignName = formAccountIds.length > 1
          ? `${formName.trim()} (${i + 1}/${formAccountIds.length})`
          : formName.trim();

        try {
          const response = await fetch('http://localhost:3001/local/campaigns', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              accountId,
              batchId,
              name: campaignName,
              description: formDescription.trim() || undefined,
              campaignType: formCampaignType,
              templateId: formTemplateId || undefined,
              recipients: accountRecipients,
              groupId: formGroupId || undefined,
              contactGroupId: formContactGroupId || undefined,
              scheduledAt: scheduledAtUTC,
              rateLimit: formRateLimit || undefined,
              delayMs: formDelayMs,
              maxRetries: formMaxRetries,
            }),
          });

          const result = await response.json();

          if (result.success) {
            successCount++;
            console.log(`Campaign created for account ${accountId}:`, result.data);
          } else {
            errors.push(`Account ${accountId}: ${result.error || 'Unknown error'}`);
          }
        } catch (err: any) {
          errors.push(`Account ${accountId}: ${err.message}`);
        }
      }

      if (successCount > 0) {
        const message = formAccountIds.length > 1
          ? `✅ Đã tạo ${successCount}/${formAccountIds.length} chiến dịch thành công${errors.length > 0 ? ` (${errors.length} lỗi)` : ''}`
          : '✅ Đã tạo chiến dịch thành công';

        setSuccess(message);
        handleCloseDialog();
        loadCampaigns();

        // Switch to list view to show success message
        setViewMode('list');
      } else {
        setDialogError(`❌ Không thể tạo chiến dịch: ${errors.join(', ')}`);
      }
    } catch (err: any) {
      console.error('Error creating campaigns:', err);
      setDialogError('❌ Không thể tạo chiến dịch. Vui lòng thử lại.');
    } finally {
      setLoading(false);
    }
  };

  const handleDeleteCampaign = async (id: number) => {
    setLoading(true);
    try {
      const response = await fetch(`http://localhost:3001/local/campaigns/${id}`, {
        method: 'DELETE',
      });

      const result = await response.json();

      if (result.success) {
        console.log('Campaign deleted successfully:', id);
        setSuccess('✅ Đã xóa chiến dịch thành công');
        setDeleteConfirmId(null);
        loadCampaigns();
      } else {
        console.error('Delete campaign failed:', result);
        setError('❌ Không thể xóa chiến dịch. Vui lòng thử lại.');
      }
    } catch (err: any) {
      console.error('Error deleting campaign:', err);
      setError('❌ Không thể xóa chiến dịch. Vui lòng kiểm tra kết nối và thử lại.');
    } finally {
      setLoading(false);
    }
  };

  const handleStartCampaign = async (campaign: Campaign) => {
    setRunningCampaignId(campaign.id);

    // If this campaign is part of a batch, start all campaigns in the batch
    if (campaign.batchId) {
      const batchCampaigns = campaigns.filter(
        (c) => c.batchId === campaign.batchId && c.status === 'pending'
      );

      console.log(`🚀 Starting batch ${campaign.batchId} with ${batchCampaigns.length} campaigns`);

      // Start all campaigns in the batch concurrently
      const startPromises = batchCampaigns.map(async (batchCampaign) => {
        await fetch(`http://localhost:3001/local/campaigns/${batchCampaign.id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            status: 'running',
            startedAt: new Date().toISOString(),
          }),
        });

        // Execute campaign in background
        executeCampaignInBackground(batchCampaign);
      });

      await Promise.all(startPromises);
      loadCampaigns();

      return; // Don't execute campaign.id again since it's already started above
    }

    // Single campaign (not part of batch)
    // Update campaign status to running
    await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        status: 'running',
        startedAt: new Date().toISOString(),
      }),
    });

    loadCampaigns();

    try {
      // Execute based on campaign type
      switch (campaign.campaignType) {
        case 'message_to_phone':
          await executeMessageToPhoneCampaign(campaign);
          break;
        case 'message_to_friends':
          await executeMessageToFriendsCampaign(campaign);
          break;
        case 'message_to_group_members':
          await executeMessageToGroupMembersCampaign(campaign);
          break;
        case 'message_to_group':
          await executeMessageToGroupCampaign(campaign);
          break;
        case 'message_birthday':
          await executeMessageBirthdayCampaign(campaign);
          break;
        case 'friend_request_phone':
          await executeFriendRequestPhoneCampaign(campaign);
          break;
        case 'friend_request_group':
          await executeFriendRequestGroupCampaign(campaign);
          break;
        case 'friend_request_suggestions':
          await executeFriendRequestSuggestionsCampaign(campaign);
          break;
        case 'invite_friend':
          await executeInviteFriendCampaign(campaign);
          break;
        case 'cancel_invite_friend':
          await executeCancelInviteFriendCampaign(campaign);
          break;
        case 'add_to_group':
          await executeAddToGroupCampaign(campaign);
          break;
        case 'join_group_by_link':
          await executeJoinGroupByLinkCampaign(campaign);
          break;
        default:
          setError(`Loại chiến dịch ${campaign.campaignType} chưa được hỗ trợ`);
          return;
      }

      // Mark as completed
      await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: 'completed',
          completedAt: new Date().toISOString(),
        }),
      });

      console.log('Campaign completed successfully:', campaign.id);
      setRunningCampaignId(null);
      loadCampaigns();
      setSuccess('Chiến dịch đã hoàn thành');
    } catch (error: any) {
      console.error('Error executing campaign:', error);
      setError('Không thể thực hiện chiến dịch. Vui lòng thử lại.');
      setRunningCampaignId(null);
      loadCampaigns();
    }
  };

  // Helper function to check pause/stop status
  // Helper function to execute campaign in background
  const executeCampaignInBackground = async (campaign: Campaign) => {
    try {
      switch (campaign.campaignType) {
        case 'message_to_phone':
          await executeMessageToPhoneCampaign(campaign);
          break;
        case 'message_to_friends':
          await executeMessageToFriendsCampaign(campaign);
          break;
        case 'message_to_group_members':
          await executeMessageToGroupMembersCampaign(campaign);
          break;
        case 'message_to_group':
          await executeMessageToGroupCampaign(campaign);
          break;
        case 'message_birthday':
          await executeMessageBirthdayCampaign(campaign);
          break;
        case 'friend_request_phone':
          await executeFriendRequestPhoneCampaign(campaign);
          break;
        case 'friend_request_group':
          await executeFriendRequestGroupCampaign(campaign);
          break;
        case 'friend_request_suggestions':
          await executeFriendRequestSuggestionsCampaign(campaign);
          break;
        case 'invite_friend':
          await executeInviteFriendCampaign(campaign);
          break;
        case 'cancel_invite_friend':
          await executeCancelInviteFriendCampaign(campaign);
          break;
        case 'add_to_group':
          await executeAddToGroupCampaign(campaign);
          break;
        case 'join_group_by_link':
          await executeJoinGroupByLinkCampaign(campaign);
          break;
        default:
          console.error(`❌ Unsupported campaign type: ${campaign.campaignType}`);
          return;
      }

      // Mark campaign as completed
      await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: 'completed',
          completedAt: new Date().toISOString(),
        }),
      });

      console.log(`✅ Campaign ${campaign.id} completed successfully`);
    } catch (err: any) {
      console.error(`❌ Campaign ${campaign.id} failed:`, err);

      // Mark campaign as failed
      await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: 'failed',
        }),
      });
    } finally {
      loadCampaigns();
    }
  };

  const checkCampaignStatus = async (campaignId: number): Promise<boolean> => {
    const current = campaigns.find((c) => c.id === campaignId);
    if (current?.status === 'stopped') return false;

    while (current?.status === 'paused') {
      await new Promise((resolve) => setTimeout(resolve, 500));
      await loadCampaigns();
    }
    return true;
  };

  // Helper function to get user info from Zalo API
  const getUserInfo = async (accountId: number, userId: string): Promise<any | null> => {
    try {
      const response = await fetch('http://localhost:3001/local/get-user-info', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accountId, userId }),
      });

      const result = await response.json();
      if (result.success) {
        return result.data;
      }
      return null;
    } catch (err) {
      console.error('Failed to get user info:', err);
      return null;
    }
  };

  // Helper function to determine vocative (anh/chị/bạn) from gender
  const getVocative = (gender: number | undefined): string => {
    if (gender === 0) return 'anh'; // Male
    if (gender === 1) return 'chị'; // Female
    return 'bạn'; // Unknown
  };

  // Helper function to capitalize first letter
  const capitalizeFirst = (str: string): string => {
    return str.charAt(0).toUpperCase() + str.slice(1);
  };

  // Helper function to generate default variables from user profile
  const generateDefaultVariables = (userProfile: any): Record<string, string> => {
    const displayName = userProfile.displayName || userProfile.zaloName || 'Bạn';
    const zaloName = userProfile.zaloName || userProfile.displayName || 'Bạn';
    const vocative = getVocative(userProfile.gender);

    // Log để debug gender detection
    console.log(`📋 User profile - Name: ${displayName}, Gender: ${userProfile.gender} (${userProfile.gender === 0 ? 'Nam' : userProfile.gender === 1 ? 'Nữ' : 'Không xác định'}), Vocative: ${vocative}`);

    return {
      // Tên hiển thị gốc trên Zalo
      FULLNAME_WEB: displayName,
      // Tên Zalo nguyên gốc
      FULLNAME_ORIGINAL: zaloName,
      // Xưng hô: anh/chị/bạn
      vocative_web: vocative,                    // anh/chị (viết thường)
      Vocative_web: capitalizeFirst(vocative),   // Anh/Chị (viết hoa chữ đầu)
      VOCATIVE_WEB: vocative.toUpperCase(),      // ANH/CHỊ (viết hoa toàn bộ)
    };
  };

  // Helper function to replace variables in template
  const replaceVariables = (content: string, variables: Record<string, string>): string => {
    // Split by "|" to get message variants
    const variants = content.split('|').map((v) => v.trim());

    // Randomly select one variant
    const selectedVariant = variants[Math.floor(Math.random() * variants.length)];

    // Replace variables with [] syntax
    let result = selectedVariant;
    Object.keys(variables).forEach((key) => {
      const regex = new RegExp(`\\[${key}\\]`, 'g');
      result = result.replace(regex, variables[key] || '');
    });

    return result;
  };

  // 1. MESSAGE_TO_PHONE: Find user by phone then send message
  const executeMessageToPhoneCampaign = async (campaign: Campaign) => {
    const template = templates.find((t) => t.id === campaign.templateId);
    if (!template) {
      console.error('Template not found for campaign:', campaign.id);
      throw new Error('Không tìm thấy template');
    }

    let sentCount = campaign.sentCount;
    let failedCount = campaign.failedCount;

    for (let i = sentCount + failedCount; i < campaign.recipients.length; i++) {
      const shouldContinue = await checkCampaignStatus(campaign.id);
      if (!shouldContinue) break;

      const recipient = campaign.recipients[i];
      let attempts = 0;
      let success = false;

      while (attempts <= campaign.maxRetries && !success) {
        try {
          // Determine target userId
          let targetUserId: string;

          if (recipient.zaloId) {
            // Priority 1: Use zaloId directly if available (skip findUser step)
            targetUserId = recipient.zaloId;
          } else {
            // Priority 2: Find user by phone number or userId
            const phoneOrUserId = recipient.phoneNumber || recipient.userId;
            const findResult = await findUser(campaign.accountId, phoneOrUserId);
            if (!findResult.success || !findResult.user) {
              throw new Error('Không tìm thấy người dùng');
            }
            targetUserId = findResult.user.userId;
          }

          // Get user info from Zalo to get default variables
          const userProfile = await getUserInfo(campaign.accountId, targetUserId);
          const defaultVariables = userProfile ? generateDefaultVariables(userProfile) : {};

          // Merge default variables with custom variables (custom variables override defaults)
          const allVariables = { ...defaultVariables, ...recipient.variables };

          // Send message (with optional image)
          const message = replaceVariables(template.content, allVariables);
          const sendResult = await sendMessage(campaign.accountId, targetUserId, message, template.imageUrl);

          if (sendResult.success) {
            success = true;
            sentCount++;
            await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ sentCount }),
            });
          } else {
            throw new Error(sendResult.error);
          }
        } catch (err: any) {
          attempts++;
          if (attempts > campaign.maxRetries) {
            failedCount++;
            await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ failedCount }),
            });
          } else {
            await new Promise((resolve) => setTimeout(resolve, 1000));
          }
        }
      }

      if (i < campaign.recipients.length - 1) {
        await new Promise((resolve) => setTimeout(resolve, campaign.delayMs));
      }
      await loadCampaigns();
    }
  };

  // 2. MESSAGE_TO_FRIENDS: Send message to friend list
  const executeMessageToFriendsCampaign = async (campaign: Campaign) => {
