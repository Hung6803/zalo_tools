  // 4. MESSAGE_TO_GROUP: Send message to group chat
  const executeMessageToGroupCampaign = async (campaign: Campaign) => {
    const template = templates.find((t) => t.id === campaign.templateId);
    if (!template) {
      console.error('Template not found for campaign:', campaign.id);
      throw new Error('Không tìm thấy template');
    }
    if (!campaign.groupId) {
      console.error('GroupId missing for campaign:', campaign.id);
      throw new Error('Không có groupId');
    }

    const message = replaceVariables(template.content, {});
    const result = await sendMessage(campaign.accountId, campaign.groupId, message, template.imageUrl);

    if (result.success) {
      await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sentCount: 1 }),
      });
    } else {
      await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ failedCount: 1 }),
      });
      throw new Error(result.error);
    }
  };

  // 5. MESSAGE_BIRTHDAY: Auto send birthday messages
  const executeMessageBirthdayCampaign = async (campaign: Campaign) => {
    const template = templates.find((t) => t.id === campaign.templateId);
    if (!template) {
      console.error('Template not found for campaign:', campaign.id);
      throw new Error('Không tìm thấy template');
    }

    // Get contacts with birthday today
    const result = await getContactsWithBirthday(campaign.accountId, true);
    if (!result.success || !result.data || result.data.length === 0) {
      console.warn('No birthday contacts found for campaign:', campaign.id);
      throw new Error('Không có ai sinh nhật hôm nay');
    }

    let sentCount = campaign.sentCount;
    let failedCount = campaign.failedCount;

    for (let i = sentCount + failedCount; i < result.data.length; i++) {
      const shouldContinue = await checkCampaignStatus(campaign.id);
      if (!shouldContinue) break;

      const contact = result.data[i];
      let attempts = 0;
      let success = false;

      while (attempts <= campaign.maxRetries && !success) {
        try {
          // Get user info from Zalo to get default variables
          const userProfile = await getUserInfo(campaign.accountId, contact.userId);
          const defaultVariables = userProfile ? generateDefaultVariables(userProfile) : {};

          // Merge with birthday-specific variables
          const allVariables = {
            ...defaultVariables,
            name: contact.displayName,
            displayName: contact.displayName,
          };

          const message = replaceVariables(template.content, allVariables);
          const sendResult = await sendMessage(campaign.accountId, contact.userId, message, template.imageUrl);

          if (sendResult.success) {
            success = true;
            sentCount++;
            await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ sentCount }),
            });
          } else {
            throw new Error(sendResult.error);
          }
        } catch (err: any) {
          attempts++;
          if (attempts > campaign.maxRetries) {
            failedCount++;
            await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ failedCount }),
            });
          } else {
            await new Promise((resolve) => setTimeout(resolve, 1000));
          }
        }
      }

      if (i < result.data.length - 1) {
        await new Promise((resolve) => setTimeout(resolve, campaign.delayMs));
      }
      await loadCampaigns();
    }
  };

  // 6. FRIEND_REQUEST_PHONE: Send friend request by phone
  const executeFriendRequestPhoneCampaign = async (campaign: Campaign) => {
    // Get template if provided (optional for friend_request campaigns)
    const template = campaign.templateId ? templates.find((t) => t.id === campaign.templateId) : null;

    let sentCount = campaign.sentCount;
    let failedCount = campaign.failedCount;

    for (let i = sentCount + failedCount; i < campaign.recipients.length; i++) {
      const shouldContinue = await checkCampaignStatus(campaign.id);
      if (!shouldContinue) break;

      const recipient = campaign.recipients[i];
      let attempts = 0;
      let success = false;

      while (attempts <= campaign.maxRetries && !success) {
        try {
          // Find user by phone
          const findResult = await findUser(campaign.accountId, recipient.userId);
          if (!findResult.success || !findResult.user) {
            throw new Error('Không tìm thấy người dùng');
          }

          // Prepare greeting message
          let message: string;
          if (template) {
            // Use template with variables
            const userProfile = await getUserInfo(campaign.accountId, findResult.user.userId);
            const defaultVariables = userProfile ? generateDefaultVariables(userProfile) : {};
            const allVariables = { ...defaultVariables, ...recipient.variables };
            message = replaceVariables(template.content, allVariables);
          } else {
            // Use default Zalo greeting or custom message
            message = recipient.variables.message || 'Xin chào, kết bạn với tôi nhé!';
          }

          // Send friend request
          const result = await sendFriendRequest(campaign.accountId, findResult.user.userId, message);

          if (result.success) {
            success = true;
            sentCount++;
            await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ sentCount }),
            });
          } else {
            throw new Error(result.error);
          }
        } catch (err: any) {
          attempts++;
          if (attempts > campaign.maxRetries) {
            failedCount++;
            await fetch(`http://localhost:3001/local/campaigns/${campaign.id}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ failedCount }),
            });
          } else {
            await new Promise((resolve) => setTimeout(resolve, 1000));
          }
        }
      }

      if (i < campaign.recipients.length - 1) {
        await new Promise((resolve) => setTimeout(resolve, campaign.delayMs));
      }
      await loadCampaigns();
    }
  };

